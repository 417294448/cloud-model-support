# Build/script output
# vertex_test.json is build_vertex_matrix.py's --limit test output
vertex_test.json

# gcloud catalog dump (input to build_vertex_matrix.py via --catalog-file; ~5MB, regeneratable).
# NOTE: the actual file in this repo is vertex_all_models.json and it IS tracked in git
# (kept as a catalog cache to avoid re-fetching). The bare name below only matches a
# plain "all_models.json" should one ever appear; it does NOT match vertex_all_models.json.
all_models.json

# refresh-model-data skill's working/backup files
# index-new.html is the candidate file during a run; promoted to index.html (does not persist)
# index-old.html is the immediately-prior index.html, overwritten each run (not a history)
index-new.html
index-old.html

# Scratch files the refresh pipeline drops in the repo root: regeneratable intermediates that
# are never part of the deployed page (apply_update.js / build_azure_models.js / update-gcp.js /
# parse-aws.js inputs & outputs, and patch files fed to `apply_update.js patch`).
vertex_new.json
mini-catalog.json
azure-models-built.json
azure-groups-built.json
gcp-retirement-patch.json
ret-patch.json
rt-patch.json
aws-retirement-patch.json
aws-api-patch.json
_build_aws_patches.js
index-aws-copy.html
diff-aws.txt
# NOTE: aws-models.json is currently tracked; ignoring it has no effect until `git rm --cached`.
aws-models.json

# Raw HTML downloaded by fetch_doc.sh when it's pointed at a repo-relative path
# instead of /tmp (bash and node agree on /tmp; python on Windows does not).
aws-region.html
aws-lifecycle.html
aws-endpoints.html
gcp-versions.html
azure-openai-ava.html
azure-others-ava.html
azure-retirement.html

# One-off hidden scraper scripts (superseded by .claude/skills/refresh-model-data/scripts/;
# they hardcode /tmp and /workspace paths, so they only ever run on the author's machine).
# They are tracked today -- remove them with `git rm --cached` if you want these rules to bite.
.build_aws_endpoints.js
.build_aws_models.js
.build_aws_retirement.js
.build_azure_openai_ava.js
.build_azure_others_ava.js
.build_azure_retirement.js
.build_gcp_retirement.js
.read_aws_data.js

# Temporary GCP service-account key (provided per-run, never commit)
.gcp-sa.json
sa.json

# Logs
*.log

# Node dependencies (local tooling, e.g. jsdom used for render verification)
node_modules/

