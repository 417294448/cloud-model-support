# Build/script output
# vertex_test.json is build_vertex_matrix.py's --limit test output
vertex_test.json

# gcloud catalog dump (input to build_vertex_matrix.py via --catalog-file; ~5MB, regeneratable).
# NOTE: the actual file in this repo is vertex_all_models.json and it IS tracked in git
# (kept as a catalog cache to avoid re-fetching). The bare name below only matches a
# plain "all_models.json" should one ever appear; it does NOT match vertex_all_models.json.
all_models.json

# refresh-model-data skill's working/backup files
# index-new.html is the candidate file during a run; promoted to index.html (does not persist)
# index-old.html is the immediately-prior index.html, overwritten each run (not a history)
index-new.html
index-old.html

# Temporary GCP service-account key (provided per-run, never commit)
.gcp-sa.json

# Logs
*.log

# Node dependencies (local tooling, e.g. jsdom used for render verification)
node_modules/
